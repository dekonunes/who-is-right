# Environment Variables for Who Is Right App

# LLM API Configuration
# Choose your LLM provider and add the corresponding API key

# OpenAI API Key (if using OpenAI)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (if using Claude)
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google AI API Key (if using Gemini)
VITE_GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Application Configuration
VITE_APP_NAME=Who Is Right
VITE_MAX_QUESTION_LENGTH=500
VITE_MAX_ANSWER_LENGTH=1000

# Optional: Rate limiting configuration
VITE_RATE_LIMIT_REQUESTS_PER_MINUTE=10

# Note: Only include the API key for the provider you're actually using
# Remove or comment out the others for security